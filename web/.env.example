DB_HOST=db.rigkit.org
DB_PORT=3306
DB_NAME=rage-wiki
DB_USER=rage-wiki
DB_PASSWORD=
# Shared key the wikisync application uses for /api/v2 (any long random string). Leave empty to disable v2.
WIKISYNC_API_KEY=
# Optional: where wikisync writes the Markdown (default: ../dist) and where its executable lives (default: ../bin/wikisync.exe)
# WIKI_ROOT=
# WIKISYNC_BIN=
# Cloudflare Turnstile (login/register). Required in production; dev falls back to Cloudflare test keys when empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
