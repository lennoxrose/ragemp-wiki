<%# locals: post, size, liked, stem %>
<div class="post <%= "has-stem" if stem %>" id="post-<%= post.id %>">
  <%= avatar_tag(post.user, size: size) %>
  <div class="post-body">
    <div class="post-meta">
      <% if post.user %><%= link_to post.user.name, member_path(post.user.username), class: "author" %><span class="role"><%= post.user.role_label %></span><% else %><span class="author">Deleted user</span><% end %>
      <span class="dim">·</span><time class="muted" datetime="<%= post.created_at.iso8601 %>" title="<%= post.created_at.strftime("%b %-d, %Y %H:%M") %>"><%= time_ago(post.created_at) %></time>
    </div>
    <div class="post-text"><%= simple_format(h(post.body), {}, sanitize: false) %></div>
    <div class="post-actions">
      <%= button_to like_post_path(post), method: :post, class: ["like", ("is-liked" if liked)], "aria-pressed": liked do %><%= icon "thumbs-up", size: 14 %><span><%= post.likes_count %></span><% end %>
      <% if post.user_id == current_user.id || current_user.admin? %><%= button_to "Delete", post_path(post), method: :delete, class: "link-muted" %><% end %>
    </div>
  </div>
</div>
