<% content_for :title, page_title("Analytics") %>
<% a = @analytics %>

<header class="admin-title">
  <div>
    <h1>Analytics</h1>
    <p class="muted">Readers, searches and account activity across the whole wiki</p>
  </div>
  <div class="admin-controls">
    <nav class="range" aria-label="Time range">
      <% Analytics::RANGES.each_key do |r| %><%= link_to r, admin_root_path(range: r), class: ["range-pill", ("is-active" if r == a.range)] %><% end %>
    </nav>
    <%= link_to admin_export_path(range: a.range), class: "btn" do %><%= icon "download" %>Export<% end %>
  </div>
</header>

<section class="kpi-strip card" aria-label="Key numbers">
  <% a.kpis.each do |k| %>
    <div class="kpi">
      <div class="eyebrow"><%= k[:label] %></div>
      <div class="kpi-main"><b><%= k[:value] %></b><%= sparkline(k[:spark], k[:color]) %></div>
      <div class="kpi-delta"><span class="<%= k[:good] ? "good" : "bad" %>"><%= k[:delta] %></span><span class="muted">vs prev. period</span></div>
    </div>
  <% end %>
</section>

<% views_series = a.views_by_category %>
<% area_svg, y_labels = stacked_area(views_series) %>
<% roles = a.role_counts %>
<div class="chart-row row-1">
  <section class="card chart-card">
    <header><div><h2>Page views</h2><p class="muted">Views per <%= a.hourly? ? "hour" : (a.weekly? ? "week" : "day") %> · stacked by category</p></div><span class="muted small">Last <%= a.range %></span></header>
    <% if area_svg %>
      <div class="plot"><div class="y-axis"><% y_labels.each do |l| %><span><%= l %></span><% end %></div><div class="plot-body"><%= area_svg %><div class="x-axis"><% labels = a.labels %><% [0, 0.25, 0.5, 0.75, 1].each do |f| %><span><%= labels[((labels.size - 1) * f).round] %></span><% end %></div></div></div>
      <ul class="legend"><% views_series.each_with_index do |s, i| %><li><span class="dot c<%= i %>"></span><%= s[:name] %></li><% end %></ul>
    <% else %>
      <p class="empty-chart muted">No page views in this period yet. Views are recorded when members open wiki pages.</p>
    <% end %>
  </section>

  <section class="card chart-card">
    <header><div><h2>Accounts by role</h2><p class="muted">Registered members</p></div><span class="muted small">All time</span></header>
    <div class="donut-row">
      <div class="donut-wrap"><%= donut(roles) %><div class="donut-center"><b><%= roles.sum { |_, n| n } %></b><span>accounts</span></div></div>
      <ul class="role-legend">
        <% total = [roles.sum { |_, n| n }, 1].max %>
        <% roles.each_with_index do |(name, n), i| %>
          <li><div class="row"><span><span class="dot c<%= i %>"></span><%= name %></span><b><%= n %> · <%= (n * 100.0 / total).round %>%</b></div><div class="track"><i class="c<%= i %>" style="width: <%= [n * 100.0 / total, 1].max %>%"></i></div></li>
        <% end %>
      </ul>
    </div>
    <p class="muted small">Registration is invite-only. Disabled accounts cannot log in.</p>
  </section>
</div>

<% hours = a.search_by_hour %>
<% hour_svg, hour_labels = hourly_lines(hours) %>
<% top_pages = a.top_pages %>
<% top_members = a.top_members %>
<% top_searches = a.top_searches %>
<div class="chart-row row-2">
  <section class="card chart-card">
    <header><div><h2>Search activity</h2><p class="muted">Searches per hour · peak vs average</p></div><span class="muted small">By hour</span></header>
    <div class="plot small-plot"><div class="y-axis"><% hour_labels.each do |l| %><span><%= l %></span><% end %></div><div class="plot-body"><%= hour_svg %><div class="x-axis"><% %w[00:00 06:00 12:00 18:00 24:00].each do |l| %><span><%= l %></span><% end %></div></div></div>
    <ul class="legend"><li><span class="dot c0"></span>Peak</li><li><span class="dot c1"></span>Average</li></ul>
  </section>

  <section class="card chart-card">
    <header><div><h2>Top pages</h2><p class="muted">Views by page</p></div><span class="muted small"><%= a.range %></span></header>
    <% if top_pages.empty? %><p class="empty-chart muted">No views yet.</p><% else %>
      <ul class="bar-list">
        <% max = top_pages.first.last %>
        <% top_pages.each_with_index do |(slug, n), i| %>
          <li><div class="row"><%= link_to slug.tr("_", " "), wiki_page_path(slug), class: "bar-label" %><b><%= delimited(n) %></b></div><div class="track"><i class="c<%= i % 3 %>" style="width: <%= [n * 100.0 / max, 2].max %>%"></i></div></li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="card chart-card">
    <header><div><h2>Top members</h2><p class="muted">Discussion posts</p></div><span class="muted small"><%= a.range %></span></header>
    <% if top_members.empty? %><p class="empty-chart muted">No discussion posts in this period.</p><% else %>
      <ul class="bar-list">
        <% max = top_members.first.last %>
        <% top_members.each_with_index do |(u, n), i| %>
          <li><div class="row"><span class="who"><%= avatar_tag(u, size: 24) %><%= link_to u.name, member_path(u.username), class: "bar-label" %></span><b><%= n %></b></div><div class="track thin"><i class="c<%= i % 3 %>" style="width: <%= [n * 100.0 / max, 3].max %>%"></i></div></li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="card chart-card">
    <header><div><h2>Top searches</h2><p class="muted">Most searched terms</p></div><span class="muted small"><%= a.range %></span></header>
    <% if top_searches.empty? %><p class="empty-chart muted">No searches yet.</p><% else %>
      <ol class="rank-list"><% top_searches.each_with_index do |(q, n), i| %><li><span class="dim"><%= i + 1 %></span><span class="term"><%= link_to q, search_path(q: q) %></span><span class="muted small"><%= n %> <%= n == 1 ? "search" : "searches" %></span></li><% end %></ol>
    <% end %>
  </section>
</div>

<% invites = a.invite_breakdown %>
<% logins = a.login_breakdown %>
<div class="chart-row row-3">
  <section class="card chart-card">
    <header><div><h2>Reading heatmap</h2><p class="muted">Hour of day · weekday</p></div></header>
    <div class="heat"><div class="heat-days"><% %w[Mon Tue Wed Thu Fri Sat Sun].each do |d| %><span><%= d %></span><% end %></div><div><%= heatmap_svg(a.heatmap) %><div class="x-axis hours"><% %w[00 06 12 18 23].each do |h| %><span><%= h %></span><% end %></div></div></div>
  </section>

  <section class="card chart-card">
    <header><div><h2>New accounts</h2><p class="muted">Registrations per month</p></div><span class="muted small">12 months</span></header>
    <%= month_bars(a.signups_by_month) %>
    <div class="x-axis months"><% a.signups_by_month.each do |l, _, _| %><span><%= l %></span><% end %></div>
  </section>

  <section class="card chart-card">
    <header><div><h2>Invites &amp; logins</h2><p class="muted">Invite codes and login outcomes</p></div><span class="muted small"><%= a.range %> logins</span></header>
    <% [["Invite codes", invites], ["Login outcomes", logins]].each do |title, parts| %>
      <% sum = parts.sum { |_, n| n } %>
      <div class="stacked">
        <div class="eyebrow"><%= title %></div>
        <% if sum.zero? %><p class="muted small">Nothing recorded yet.</p><% else %>
          <div class="stack-bar"><% parts.each_with_index do |(name, n), i| %><% next if n.zero? %><span class="c<%= i %>" style="flex: <%= n %>" title="<%= name %>: <%= n %>"><%= "#{(n * 100.0 / sum).round}%" if n * 100.0 / sum >= 8 %></span><% end %></div>
          <ul class="legend"><% parts.each_with_index do |(name, n), i| %><li><span class="dot c<%= i %>"></span><%= name %> · <%= n %></li><% end %></ul>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
