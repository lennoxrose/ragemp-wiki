<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : page_title("Admin") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap">
    <%= stylesheet_link_tag :app %>
    <%= yield :head %>
  </head>
  <body class="admin-body">
    <%= render "shared/header" %>
    <div class="admin-shell">
      <aside class="admin-side" aria-label="Admin sections">
        <div class="eyebrow">Admin</div>
        <%= link_to admin_root_path, class: ["side-link", ("is-active" if controller_name == "analytics")] do %><%= icon "chart-column", size: 18 %>Analytics<% end %>
        <%= link_to admin_users_path, class: ["side-link", ("is-active" if controller_name == "users")] do %><%= icon "users", size: 18 %>Accounts<% end %>
        <%= link_to admin_sync_path, class: ["side-link", ("is-active" if controller_name == "sync")] do %><%= icon "refresh-cw", size: 18 %>Sync<% end %>
        <hr>
        <%= link_to root_path, class: "side-link" do %><%= icon "arrow-left", size: 18 %>Back to wiki<% end %>
      </aside>
      <div class="admin-content">
        <% flash.each do |type, message| %><p class="flash <%= type %>" role="status"><%= message %></p><% end %>
        <%= yield %>
      </div>
    </div>
    <%= javascript_include_tag "app", "admin", defer: true %>
  </body>
</html>
